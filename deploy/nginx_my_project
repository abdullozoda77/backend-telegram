server {
    listen 80;
    server_name example.tj;

    client_max_body_size 20M;

    location /static/ {
        root /home/admin/my_project;
    }

    location /media/ {
        root /home/admin/my_project;
    }

    location / {
        include proxy_params;
        proxy_pass http://127.0.0.1:8000;
    }
}
